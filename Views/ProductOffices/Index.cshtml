@model IEnumerable<ClearStore.Models.ProductOffice>
@{
    ViewData["Title"] = "Product Offices";
}

<div class="cp-view-container view-md">
    <div class="cp-view-content">
        <header class="cp-view-header">
            <h1>@ViewData["Title"]</h1>
            <div class="hstack gap">
                <a asp-controller="Home" asp-action="Index" class="cp-button gray">Back to store</a>
                <a asp-action="Create" class="cp-button filled">New office</a>
            </div>
        </header>
        @if ((await AuthorizationService.AuthorizeAsync(User, "storeadmins")).Succeeded)
        {
            <h1>Web Store Admin</h1>
        }
        <section class="cp-section">
            <table class="cp-table compact">
                <thead>
                    <tr>
                        <th>Office</th>
                        <th></th>
                    </tr>
                </thead>
                @foreach (var office in Model)
                {
                    <tr>
                        <td>@office.Location</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@office.Id" class="link">Edit</a>
                        </td>
                    </tr>
                }
            </table>
        </section>
    </div>
</div>

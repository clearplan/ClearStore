<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Clearstore | @ViewData["Title"]</title>
    <link rel="shortcut icon" type="image/x-icon" href="/img/favicon.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&family=IBM+Plex+Sans:ital,wght@0,100..700;1,100..700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/fluent/fluent.clean.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cp.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body>
    <div class="cp-layout" data-layout>
        <header class="cp-layout-header" data-layout-header>
            <div class="cp-logo">
                <img src="/img/clearstore-logo.svg" alt="ClearStore logo" />
            </div>
            @await Component.InvokeAsync(nameof(VCUserCart))
        </header>
        <aside class="cp-layout-sidebar" data-layout-sidebar>
            @{ await Html.RenderPartialAsync("_Sidebar"); }
        </aside>
        <main class="cp-layout-viewport" role="main" data-layout-viewport>
            <header class="cp-toolbar">
                <i class="fi fi-panel-left-header-regular fs-20" data-toggle-layout-sidebar></i>
            </header>
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script type="module" src="~/js/utils/cp/cp.js" asp-append-version="true"></script>
    <script type="module" src="~/js/app.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

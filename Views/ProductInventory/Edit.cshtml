@model ClearStore.ViewModels.ProductInventoryCrudModel
@{
    var dto = Model.ProductInventoryDto;
    ViewData["Title"] = "Edit Inventory";
    ViewData["PageTitle"] = dto.Product.Name;
}

<div class="cp-view-container view-xl">
    <div class="cp-view-content">
        <header class="cp-view-header">
            <h1>@ViewData["PageTitle"]</h1>
            <div class="hstack gap">
                <a asp-action="Index" class="cp-button gray">Inventory home</a>
                <a asp-controller="Products" asp-action="Edit" asp-route-id="@Model.ProductInventoryDto.Product.Id" class="cp-button gray">Product details</a>
            </div>
        </header>
        <section class="cp-section">
            <div class="cp-notice info compact">
                <p><b>Instructions: </b>Click the <code>Add inventory</code> button below to append a row with <code>size</code>, <code>color</code>, <code>location</code>, <code>quantity</code>, and <code>visibility</code> options.</p>
            </div>
            <fieldset class="cp-fieldset">
                <input type="hidden" asp-for="ProductInventoryDto.Product.Id" data-productid />
                <legend>Manage inventory</legend>
                @if (dto.ProductImageDto != null)
                {
                    <figure class="cp-frame istack">
                        <div class="thumbnail">
                            <img src="@Url.Action("GetImage", "Images", new { id = dto.ProductImageDto.Id })"
                                 class="img-10"
                                 alt="@dto.ProductImageDto.ImageName" />
                        </div>
                    </figure>
                }
                <div class="cp-field-row">
                    <div class="cp-field-group">
                        <label class="cp-field-label">Name</label>
                        <input type="text" class="cp-field" value="@dto.Product.Name" readonly />
                    </div>
                </div>
                <div class="cp-field-row">
                    <div class="cp-field-group">
                        <label class="cp-field-label">Description</label>
                        <input type="text" class="cp-field" value="@dto.Product.Description" readonly />
                    </div>
                </div>
                <table class="cp-table compact" data-inventory-table>
                    <tbody>
                        @if (dto.ProductInventory.Count > 0)
                        {
                            for (int i = 0; i < dto.ProductInventory.Count; i++)
                            {
                                var inventory = dto.ProductInventory[i];
                                <tr data-row>
                                    <td>
                                        <select asp-items="@(new SelectList(Model.ProductSizes, "Id", "Name", inventory.ProductSizeId))"
                                                class="cp-field full"
                                                data-size></select>
                                    </td>
                                    <td>
                                        <select asp-items="@(new SelectList(Model.ProductColors, "Id", "Name", inventory.ProductColorId))"
                                                class="cp-field full"
                                                data-color></select>
                                    </td>
                                    <td>
                                        <select asp-items="@(new SelectList(Model.ProductOffices, "Id", "Location", inventory.ProductOfficeId))"
                                                class="cp-field full"
                                                data-office></select>
                                    </td>
                                    <td>
                                        <input asp-for="ProductInventoryDto.ProductInventory[@i].Quantity" class="cp-field full" data-quantity />
                                    </td>
                                    <td>
                                        <select asp-for="ProductInventoryDto.ProductInventory[@i].IsVisible" class="cp-field full" data-visibility>
                                            <option value="true">Visible</option>
                                            <option value="false">Hidden</option>
                                        </select>
                                    </td>
                                    <td>
                                        <div class="hstack gap-sm">
                                            <button type="button" class="cp-button filled info compact fill" data-inventory-save>Update</button>
                                            <button type="button" class="cp-button filled warning compact fill" data-inventory-remove>Delete</button>
                                        </div>
                                    </td>
                                    <input type="hidden" data-id="" value="@inventory.Id" />
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </fieldset>
            <div class="cp-field-actions">
                <button type="button" role="button" class="cp-button muted success hstack gap-md" data-add-row>
                    <i class="fi fi-add-regular"></i>
                    <span>Add row</span>
                </button>
            </div>
        </section>
    </div>
</div>

<template id="inventoryRow">
    <tr data-row>
        <td>
            <select asp-items="@(new SelectList(Model.ProductSizes, "Id", "Name", null))"
                    class="cp-field full"
                    data-inventory-size></select>
        </td>
        <td>
            <select asp-items="@(new SelectList(Model.ProductColors, "Id", "Name", null))"
                    class="cp-field full"
                    data-inventory-color></select>
        </td>
        <td>
            <select asp-items="@(new SelectList(Model.ProductOffices, "Id", "Location", null))"
                    class="cp-field full"
                    data-inventory-office></select>
        </td>
        <td>
            <input type="number" class="cp-field full" placeholder="Enter quantity" data-inventory-quantity />
        </td>
        <td>
            <select class="cp-field full" data-inventory-visibility>
                <option value="true">Visible</option>
                <option value="false">Hidden</option>
            </select>
        </td>
        <td>
            <div class="hstack gap-sm">
                <button type="button" class="cp-button muted success compact fill" data-inventory-save>Save</button>
                <button type="button" class="cp-button muted warning compact fill" data-inventory-remove>Remove</button>
            </div>
        </td>
    </tr>
</template>

@section Scripts {
    <script type="module" src="~/js/inventory/edit.js" asp-append-version="true"></script>
}

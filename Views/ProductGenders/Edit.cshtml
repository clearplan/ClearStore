@model ClearStore.Models.ProductGender
@{
    ViewData["Title"] = "Edit Product Size";
}

<div class="cp-view-container view-md">
    <div class="cp-view-content">
        <header class="cp-view-header">
            <h1>@ViewData["Title"]</h1>
            <a asp-controller="Home" asp-action="Index" class="cp-button gray">Back to store</a>
            <a asp-controller="ProductGenders" asp-action="Index" class="cp-button gray">Product genders</a>
        </header>
        <section class="cp-section">
            <form asp-action="Edit" asp-antiforgery="true">
                <input type="hidden" asp-for="Id" />
                <div class="cp-field-row">
                    <div class="cp-field-group">
                        <label asp-for="Name" class="cp-field-label"></label>
                        <input asp-for="Name" class="cp-field" />
                        <span asp-validation-for="Name"></span>
                    </div>
                </div>
                <div class="cp-field-actions">
                    <button type="submit" role="button" class="cp-button filled">Update</button>
                </div>
            </form>
        </section>
    </div>
</div>
